# Supabase: click "Connect" in your project, copy the Session pooler connection string,
# and replace [YOUR-PASSWORD]. If the password has special characters (@ : / # ?),
# URL-encode them (for example @ becomes %40).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:3000
